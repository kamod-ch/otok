{
  "name": "playground",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --mode client",
    "build:server": "vite build",
    "preview": "vite preview",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-kamod": "workspace:*",
    "@kamod-ch/otok-plugin-hello": "workspace:*",
    "@kamod-ui/core": "^0.1.5",
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.12",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@kamod-ch/otok-vite-plugin": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
