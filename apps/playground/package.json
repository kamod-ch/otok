    "@kamod-ch/themes": "^0.2.2",
    "@kamod-ch/ui": "^2.2.0",
    "@preact/signals": "^2.11.4",
    "hono": "^4.13.19",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@kamod-ch/otok-vite-plugin": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
