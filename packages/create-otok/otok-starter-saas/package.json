{
  "name": "otok-starter-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --mode client",
    "build:server": "vite build",
    "preview": "vite preview",
    "start": "node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "otok db:migrate",
    "db:seed": "otok db:seed",
    "db:status": "otok db:status"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kamod-ch/otok": "^1.0.0",
    "@kamod-ch/otok-auth": "^1.1.0",
    "@kamod-ch/otok-i18n": "^2.0.0",
    "@kamod-ch/otok-kamod": "^1.0.0",
    "@kamod-ch/otok-kysely": "^1.0.0",
    "@kamod-ch/otok-security": "^1.0.0",
    "@kamod-ch/otok-seo": "^1.0.0",
    "@kamod-ch/otok-validation": "^1.0.0",
    "@kamod-ch/ui": "^2.0.0",
    "@preact/signals": "^2.11.3",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
