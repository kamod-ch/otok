    "@kamod-ch/otok-kysely": "^1.0.0",
    "@kamod-ch/otok-security": "^1.0.0",
    "@kamod-ch/otok-seo": "^1.0.0",
    "@kamod-ch/otok-validation": "^1.0.0",
    "@kamod-ch/ui": "^1.0.1",
    "@preact/signals": "^2.0.0",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.12.25",
    "kysely": "^0.29.2",
