  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@kamod-ch/otok-vite-plugin": "^1.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
