    "@kamod-ch/otok": "^2.2.0",
    "@kamod-ch/otok-kamod": "workspace:*",
    "@kamod-ch/themes": "^0.2.2",
    "@kamod-ch/ui": "^2.1.0",
    "@preact/signals": "^2.11.4",
    "hono": "^4.13.16",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@kamod-ch/otok-vite-plugin": "^2.1.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
