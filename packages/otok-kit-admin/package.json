{
  "name": "@otok/kit-admin",
  "version": "0.1.0",
  "description": "Admin shell kit — users, roles, org settings.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "kit-files", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./kit": { "types": "./dist/kit.d.ts", "default": "./dist/kit.js" }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@otok/config": "workspace:*" },
  "devDependencies": { "typescript": "~6.0.2", "vitest": "^4.1.2" }
}
