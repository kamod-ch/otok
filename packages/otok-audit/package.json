{
  "name": "@kamod-ch/otok-audit",
  "version": "0.1.1",
  "description": "Immutable audit trail for Otok \u2014 actor, action, resource, changes, multi-tenant search and export.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./providers/kysely": {
      "types": "./dist/providers/kysely/index.d.ts",
      "default": "./dist/providers/kysely/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./crm": {
      "types": "./dist/crm/index.d.ts",
      "default": "./dist/crm/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-config": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.0",
    "hono": ">=4",
    "kysely": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.12.25",
    "kysely": "^0.29.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-audit#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-audit"
  }
}
