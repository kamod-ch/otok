{
  "name": "@kamod-ch/otok-storage",
  "version": "1.0.0",
  "description": "Provider-based object storage for Otok — local filesystem, S3, R2, and MinIO.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-storage#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-storage"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/local": {
      "types": "./dist/providers/local.d.ts",
      "default": "./dist/providers/local.js"
    },
    "./providers/s3": {
      "types": "./dist/providers/s3.d.ts",
      "default": "./dist/providers/s3.js"
    },
    "./providers/test": {
      "types": "./dist/providers/test.d.ts",
      "default": "./dist/providers/test.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.876.0",
    "@aws-sdk/s3-request-presigner": "^3.876.0",
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-test": "workspace:*",
    "@types/node": "^24.12.2",
    "hono": "^4.13.8",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
