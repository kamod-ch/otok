{
  "name": "@kamod-ch/otok-ai",
  "version": "2.1.0",
  "description": "Framework-wide AI integration for Otok — streaming, tools, agents, RAG, budgets, MCP.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-ai#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-ai"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./providers/test": {
      "types": "./dist/providers/test.d.ts",
      "default": "./dist/providers/test.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./tools": {
      "types": "./dist/tools/define-tool.d.ts",
      "default": "./dist/tools/define-tool.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "default": "./dist/rag/index.js"
    },
    "./budget/kysely": {
      "types": "./dist/budget/kysely/index.d.ts",
      "default": "./dist/budget/kysely/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-test": "workspace:*",
    "@kamod-ch/otok-workflows": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=2.1.0",
    "@kamod-ch/otok-workflows": ">=2.1.0",
    "hono": ">=4",
    "kysely": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@kamod-ch/otok-workflows": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
