{
  "name": "@kamod-ch/otok",
  "version": "0.6.1",
  "description": "Hono + Preact Islands framework runtime.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./route": {
      "types": "./dist/route/index.d.ts",
      "default": "./dist/route/index.js"
    },
    "./rendering": {
      "types": "./dist/rendering/index.d.ts",
      "default": "./dist/rendering/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./client/mutations": {
      "types": "./dist/client/mutations/index.d.ts",
      "default": "./dist/client/mutations/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-config": "workspace:*",
    "hono": "^4.13.8",
    "preact-render-to-string": "^6.7.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.1",
    "@types/node": "^24.12.2",
    "kysely": "^0.29.3",
    "preact": "^10.28.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@hono/node-server": ">=2.0.0",
    "kysely": ">=0.27.0",
    "preact": ">=10.26.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
