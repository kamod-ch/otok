{
  "name": "@kamod-ch/otok-config",
  "version": "0.3.0",
  "description": "Typed plugin API and config resolution for Otok apps.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-config#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
