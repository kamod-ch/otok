{
  "name": "@kamod-ch/otok-plugin-fixture",
  "version": "1.1.0",
  "description": "Otok plugin fixture used by tests to exercise multiple plugin hooks.",
  "license": "MIT",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-plugin-fixture#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-plugin-fixture"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    }
  },
  "otok": {
    "setup": "./dist/setup.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "hono": ">=4",
    "vite": ">=6"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@types/node": "^24.12.2",
    "hono": "^4.12.25",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
