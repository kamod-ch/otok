{
  "name": "@kamod-ch/otok-route-typegen",
  "version": "0.1.0",
  "description": "Route tree parsing, conflict detection, and TypeScript type generation for Otok apps.",
  "license": "MIT",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-route-typegen#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-route-typegen"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:route-types",
    "typecheck:route-types": "tsc -p fixtures/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
