{
  "name": "@kamod-ch/otok-workflows",
  "version": "1.0.0",
  "description": "Durable multi-step workflows for Otok — typed steps, retries, cron, and persistent providers.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-workflows#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-workflows"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./providers/kysely": {
      "types": "./dist/providers/kysely/index.d.ts",
      "default": "./dist/providers/kysely/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./crm": {
      "types": "./dist/crm/index.d.ts",
      "default": "./dist/crm/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-config": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "hono": ">=4",
    "kysely": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
