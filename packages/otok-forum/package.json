{
  "name": "@kamod-ch/otok-forum",
  "version": "2.1.0",
  "description": "Production-ready optional forum extension for Otok — SSR, Kysely, permissions, moderation.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-forum#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-forum"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kysely": {
      "types": "./dist/kysely/index.d.ts",
      "default": "./dist/kysely/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-config": "workspace:*",
    "markdown-it": "^15.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-test": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.13.17",
    "kysely": "^0.29.8",
    "preact": "^11.2.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=2.1.0",
    "hono": ">=4",
    "kysely": ">=0.27.0",
    "preact": ">=10.26.0"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "preact": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
