{
  "name": "@kamod-ch/otok-kit-saas",
  "version": "2.0.0",
  "description": "Billing kit — Stripe checkout, portal, webhooks, and subscriptions.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-kit-saas#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-kit-saas"
  },
  "files": [
    "dist",
    "kit-files",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-config": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
