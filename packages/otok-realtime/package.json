{
  "name": "@kamod-ch/otok-realtime",
  "version": "0.1.0",
  "description": "Typed SSE and WebSocket realtime for Otok — channels, rooms, presence, and scalable providers.",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./providers/redis": {
      "types": "./dist/providers/redis.d.ts",
      "default": "./dist/providers/redis.js"
    },
    "./providers/durable-objects": {
      "types": "./dist/providers/durable-objects.d.ts",
      "default": "./dist/providers/durable-objects.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./crm": {
      "types": "./dist/crm/index.d.ts",
      "default": "./dist/crm/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@otok/config": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "hono": ">=4",
    "otok": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "hono": { "optional": true },
    "@kamod-ch/otok-auth": { "optional": true },
    "@kamod-ch/otok-observability": { "optional": true },
    "@kamod-ch/otok-security": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "hono": "^4.12.25",
    "otok": "workspace:*",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "ws": "^8.19.0"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
