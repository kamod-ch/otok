{
  "name": "@kamod-ch/otok-realtime",
  "version": "0.1.1",
  "description": "Typed SSE and WebSocket realtime for Otok \u2014 channels, rooms, presence, and scalable providers.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./providers/redis": {
      "types": "./dist/providers/redis.d.ts",
      "default": "./dist/providers/redis.js"
    },
    "./providers/durable-objects": {
      "types": "./dist/providers/durable-objects.d.ts",
      "default": "./dist/providers/durable-objects.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./crm": {
      "types": "./dist/crm/index.d.ts",
      "default": "./dist/crm/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-config": "workspace:*",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.0",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@kamod-ch/otok-auth": {
      "optional": true
    },
    "@kamod-ch/otok-observability": {
      "optional": true
    },
    "@kamod-ch/otok-security": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@types/node": "^24.12.2",
    "@types/ws": "^8.18.1",
    "hono": "^4.12.25",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-realtime#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-realtime"
  }
}
