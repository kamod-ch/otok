{
  "name": "otok-cli",
  "version": "0.2.1",
  "description": "CLI for Otok apps — add plugins, manage configuration.",
  "license": "MIT",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-cli#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-cli"
  },
  "type": "module",
  "bin": {
    "otok": "./bin/otok.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok-ai": "workspace:*",
    "@kamod-ch/otok-kysely": "workspace:*",
    "@kamod-ch/otok-config": "workspace:*",
    "@kamod-ch/otok-registry": "workspace:*",
    "@kamod-ch/otok-route-typegen": "workspace:*",
    "typescript": "~6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
