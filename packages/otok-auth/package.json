{
  "name": "@kamod-ch/otok-auth",
  "version": "1.0.0",
  "description": "Cookie sessions, CSRF, and route middleware helpers for Otok apps.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-auth#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-auth"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "default": "./dist/middleware/index.js"
    },
    "./csrf": {
      "types": "./dist/csrf.d.ts",
      "default": "./dist/csrf.js"
    },
    "./password": {
      "types": "./dist/password.d.ts",
      "default": "./dist/password.js"
    },
    "./password/webcrypto": {
      "types": "./dist/password-webcrypto.d.ts",
      "default": "./dist/password-webcrypto.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./adapters/kysely": {
      "types": "./dist/adapters/kysely.d.ts",
      "default": "./dist/adapters/kysely.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./redirect": {
      "types": "./dist/redirect.d.ts",
      "default": "./dist/redirect.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-test": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^24.12.2",
    "hono": "^4.13.8",
    "kysely": "^0.29.2",
    "preact": "^10.28.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "@node-rs/argon2": ">=2.0.0",
    "hono": ">=4",
    "kysely": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "@node-rs/argon2": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
