{
  "name": "@kamod-ch/otok-test",
  "version": "1.0.0",
  "description": "Official server-side and client testing utilities for Otok apps.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-test#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-test"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamod-ch/otok": "workspace:*",
    "otok-adapter-contract": "workspace:*"
  },
  "devDependencies": {
    "@kamod-ch/otok-plugin-hello": "workspace:*",
    "@types/node": "^26.6.3",
    "hono": "^4.13.12",
    "jsdom": "^26.1.0",
    "preact": "^11.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "hono": ">=4",
    "preact": ">=10.26.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
