{
  "name": "@kamod-ch/otok-mail",
  "version": "2.0.0",
  "description": "Provider-based mail integration for Otok — SMTP, Resend, Mailpit, and test providers.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-mail#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-mail"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/test": {
      "types": "./dist/providers/test.d.ts",
      "default": "./dist/providers/test.js"
    },
    "./providers/smtp": {
      "types": "./dist/providers/smtp.d.ts",
      "default": "./dist/providers/smtp.js"
    },
    "./providers/resend": {
      "types": "./dist/providers/resend.d.ts",
      "default": "./dist/providers/resend.js"
    },
    "./providers/mailpit": {
      "types": "./dist/providers/mailpit.d.ts",
      "default": "./dist/providers/mailpit.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-test": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "hono": "^4.13.12",
    "nodemailer": "^10.0.13",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.7.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "hono": ">=4",
    "preact": ">=10"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
