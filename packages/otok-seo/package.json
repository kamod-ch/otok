{
  "name": "@kamod-ch/otok-seo",
  "version": "2.0.0",
  "description": "Typed route metadata, sitemaps, feeds, and SEO helpers for Otok apps.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-seo#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-seo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sitemap": {
      "types": "./dist/sitemap.d.ts",
      "default": "./dist/sitemap.js"
    },
    "./feeds": {
      "types": "./dist/feeds.d.ts",
      "default": "./dist/feeds.js"
    },
    "./robots": {
      "types": "./dist/robots.d.ts",
      "default": "./dist/robots.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-i18n": "workspace:*",
    "@kamod-ch/otok-test": "workspace:*",
    "@types/node": "^26.6.3",
    "hono": "^4.13.12",
    "preact": "^11.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "@kamod-ch/otok-i18n": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
