{
  "name": "@kamod-ch/otok-supabase",
  "version": "1.0.0",
  "description": "Supabase SSR, cookie auth, and middleware integration for Otok apps.",
  "license": "MIT",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-supabase#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-supabase"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "default": "./dist/registry.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "default": "./dist/realtime/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.49.0",
    "hono": ">=4",
    "otok": ">=0.6.0"
  },
  "devDependencies": {
    "@kamod-ch/otok-test": "workspace:*",
    "@supabase/supabase-js": "^2.99.0",
    "@types/node": "^24.12.2",
    "hono": "^4.12.25",
    "otok": "workspace:*",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
