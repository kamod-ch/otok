{
  "name": "@kamod-ch/otok-oauth",
  "version": "1.0.0",
  "description": "OAuth login helpers (GitHub, Google, Microsoft, GitLab) for Otok apps.",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-oauth#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-oauth"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "default": "./dist/adapter/index.js"
    },
    "./providers/github": {
      "types": "./dist/providers/github.d.ts",
      "default": "./dist/providers/github.js"
    },
    "./providers/google": {
      "types": "./dist/providers/google.d.ts",
      "default": "./dist/providers/google.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./providers/microsoft": {
      "types": "./dist/providers/microsoft.d.ts",
      "default": "./dist/providers/microsoft.js"
    },
    "./providers/gitlab": {
      "types": "./dist/providers/gitlab.d.ts",
      "default": "./dist/providers/gitlab.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-auth": "workspace:*",
    "@types/node": "^24.12.2",
    "arctic": "^3.7.0",
    "hono": "^4.13.8",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@kamod-ch/otok": ">=0.6.1",
    "@kamod-ch/otok-auth": ">=1.0.0",
    "arctic": ">=3.0.0",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "otok": {
      "optional": true
    },
    "@kamod-ch/otok-auth": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
