{
  "name": "@kamod-ch/otok-queue",
  "version": "1.0.0",
  "description": "Provider-based job queue for Otok — typed jobs, retry, idempotency, cron, and in-memory dev provider.",
  "license": "MIT",
  "homepage": "https://github.com/kamod-ch/otok/tree/main/packages/otok-queue#readme",
  "bugs": {
    "url": "https://github.com/kamod-ch/otok/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/otok.git",
    "directory": "packages/otok-queue"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/memory": {
      "types": "./dist/providers/memory.d.ts",
      "default": "./dist/providers/memory.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "hono": ">=4",
    "otok": ">=0.6.0"
  },
  "devDependencies": {
    "@kamod-ch/otok-test": "workspace:*",
    "@types/node": "^24.12.2",
    "hono": "^4.12.25",
    "otok": "workspace:*",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
