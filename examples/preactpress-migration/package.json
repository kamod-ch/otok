{
  "name": "preactpress-migration",
  "version": "0.1.0",
  "private": true,
  "description": "Representative PreactPress docs page migrated to Otok + otok-content.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-content": "workspace:*",
    "@kamod-ch/otok-i18n": "workspace:*",
    "@kamod-ch/otok-kamod": "workspace:*",
    "@kamod-ch/otok-seo": "workspace:*",
    "@kamod-ch/otok-vite-plugin": "workspace:*",
    "@kamod-ch/preactpress-compat": "workspace:*",
    "@kamod-ch/ui": "^2.1.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "hono": "^4.13.17",
    "otok-adapter-static": "workspace:*",
    "preact": "^11.2.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
