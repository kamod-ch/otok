{
  "name": "reference-ai-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Otok app for an AI-assisted repository audit workflow.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --mode client && vite build",
    "preview": "NODE_ENV=production node ./dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-vite-plugin": "workspace:*",
    "@preact/preset-vite": "^2.10.6",
    "hono": "^4.13.12",
    "preact": "^11.0.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "~7.0.2"
  }
}
