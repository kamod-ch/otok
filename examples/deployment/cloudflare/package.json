{
  "name": "otok-deployment-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers deployment example for Otok using createOtokWorkerApp.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:client": "vite build --mode client",
    "build:worker": "vite build",
    "build": "pnpm run build:client && pnpm run build:worker",
    "typecheck": "node ./scripts/ensure-manifest-stub.mjs && tsc -p tsconfig.json --noEmit",
    "preview": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "smoke": "pnpm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@kamod-ch/otok": "^1.0.0",
    "@kamod-ch/otok-vite-plugin": "^1.0.0",
    "@preact/preset-vite": "^2.10.6",
    "hono": "^4.13.12",
    "preact": "^11.0.0",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.3",
    "typescript": "~7.0.2",
    "wrangler": "^4.145.0"
  }
}
