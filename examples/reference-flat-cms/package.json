{
  "name": "reference-flat-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Reference Otok app for a flat-file content management workflow.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --mode client && vite build",
    "preview": "NODE_ENV=production node ./dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/vite-dev-server": "^0.26.1",
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-vite-plugin": "workspace:*",
    "@preact/preset-vite": "^2.10.6",
    "hono": "^4.13.17",
    "preact": "^11.2.0",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~7.0.2"
  }
}
