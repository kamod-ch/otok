{
  "name": "kit-crm-swiss",
  "version": "0.1.0",
  "private": true,
  "description": "Swiss B2B CRM reference product for Otok — real business flows, not a demo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "otok db:migrate",
    "db:seed": "otok db:seed",
    "db:status": "otok db:status",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@kamod-ch/otok": "workspace:*",
    "@kamod-ch/otok-audit": "workspace:*",
    "@kamod-ch/otok-auth": "workspace:*",
    "@kamod-ch/otok-i18n": "workspace:*",
    "@kamod-ch/otok-kamod": "workspace:*",
    "@kamod-ch/otok-kit-crm": "workspace:*",
    "@kamod-ch/otok-kysely": "workspace:*",
    "@kamod-ch/otok-search": "workspace:*",
    "@kamod-ch/otok-validation": "workspace:*",
    "@kamod-ch/otok-workflows": "workspace:*",
    "@kamod-ch/ui": "^1.3.0",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "otok-adapter-node": "workspace:*",
    "pg": "^8.23.0",
    "preact": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@kamod-ch/otok-vite-plugin": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "otok-cli": "workspace:*",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  }
}
