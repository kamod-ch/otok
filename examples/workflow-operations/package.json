{
  "name": "workflow-operations",
  "version": "0.1.0",
  "private": true,
  "description": "Optional workflow operator reference app (Plan 034) — list, detail, pause/resume/approve/cancel.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
