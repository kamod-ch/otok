    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@kamod-ch/otok-workflows": "workspace:*",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  }
}
