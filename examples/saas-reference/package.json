{
  "name": "saas-reference",
  "private": true,
  "version": "0.1.0",
  "description": "Full-stack Otok SaaS reference application — auth, orgs, billing, audit.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:seed": "tsx scripts/db.ts seed",
    "db:status": "tsx scripts/db.ts status",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@kamod-ch/otok-audit": "workspace:*",
    "@kamod-ch/otok-auth": "workspace:*",
    "@kamod-ch/otok-i18n": "workspace:*",
    "@kamod-ch/otok-kamod": "workspace:*",
    "@kamod-ch/otok-kysely": "workspace:*",
    "@kamod-ch/otok-mail": "workspace:*",
    "@kamod-ch/otok-oauth": "workspace:*",
    "@kamod-ch/otok-observability": "workspace:*",
    "@kamod-ch/otok-security": "workspace:*",
    "@kamod-ch/otok-seo": "workspace:*",
    "@kamod-ch/otok-stripe": "workspace:*",
    "@kamod-ch/otok-validation": "workspace:*",
    "@kamod-ch/ui": "^1.0.1",
    "@preact/signals": "^2.9.1",
    "hono": "^4.12.25",
    "kysely": "^0.29.2",
    "otok": "workspace:*",
    "otok-adapter-node": "workspace:*",
    "pg": "^8.16.0",
    "preact": "^10.28.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@otok/vite-plugin": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "otok-cli": "workspace:*",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.2"
  }
}
