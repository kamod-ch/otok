{
  "name": "otok-workspace",
  "version": "0.1.0",
  "private": true,
  "author": "Klaus Zahiragic <watzak>",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter playground build && pnpm --filter docs build",
    "check:examples": "node ./scripts/check-examples.mjs",
    "check:workflow-operations": "node ./scripts/check-workflow-operations.mjs",
    "check:realtime-cloudflare": "node ./scripts/check-realtime-cloudflare.mjs",
    "check:scaffold": "node ./scripts/sync-scaffold.mjs --check",
    "changeset": "pnpm dlx @changesets/cli",
    "dev": "pnpm --filter playground dev",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "format:whitespace": "node ./scripts/format-check.mjs",
    "lint": "pnpm lint:oxlint && pnpm lint:policy",
    "lint:oxlint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:policy": "node ./scripts/lint.mjs",
    "metadata:check": "node ./scripts/verify-package-metadata.mjs",
    "docs:release:check": "node ./scripts/check-release-docs.mjs",
    "test:release-docs": "node --test scripts/check-release-docs.test.mjs",
    "pack:check": "pnpm metadata:check && pnpm -r --filter './packages/*' build && pnpm -r --filter './packages/*' exec npm pack --dry-run",
    "preview": "pnpm --filter playground preview",
    "release:check": "node ./scripts/release-check.mjs",
    "release:publish": "node ./scripts/publish-packages.mjs",
    "release": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:dry": "node ./scripts/release.mjs patch --dry",
    "smoke:node": "node ./scripts/production-smoke.mjs",
    "smoke:cloudflare": "node ./scripts/smoke-cloudflare.mjs",
    "sync:scaffold": "node ./scripts/sync-scaffold.mjs",
    "typecheck": "pnpm -r --filter './packages/*' build && pnpm -r typecheck",
    "test": "pnpm -r --filter '!realtime-cloudflare' test",
    "test:e2e": "pnpm --filter playground test:e2e",
    "version-packages": "pnpm dlx @changesets/cli version",
    "check": "pnpm check:scaffold && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "api:check": "node ./scripts/check-api-stability.mjs",
    "api:snapshot:check": "node ./scripts/check-api-snapshot.mjs",
    "api:snapshot:update": "node ./scripts/update-api-snapshot.mjs",
    "budget:check": "node ./scripts/check-budgets.mjs",
    "budget:measure": "node ./scripts/measure-bundle-budgets.mjs",
    "check:pack-consumer": "node ./scripts/check-pack-consumer.mjs",
    "test:gates": "node --test scripts/check-gates.test.mjs",
    "bench:otok": "node ./benchmarks/run-otok.mjs",
    "bench:compare": "node ./benchmarks/bench-compare.mjs",
    "reproducible:check": "node ./scripts/reproducible-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^27.4.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
